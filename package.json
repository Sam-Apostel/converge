{
  "name": "converge",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate-icons": "bun scripts/generate-icons.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run db:migrate && bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "bunx @better-auth/cli@1.6.16 generate --config src/lib/auth.ts --output src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check && oxlint",
    "knip": "knip"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.16",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@progress/kendo-licensing": "^1.11.2",
    "@progress/kendo-react-buttons": "^15.0.0",
    "@progress/kendo-react-dialogs": "^15.0.0",
    "@progress/kendo-react-indicators": "^15.0.0",
    "@progress/kendo-react-inputs": "^15.0.0",
    "@progress/kendo-react-labels": "^15.0.0",
    "@progress/kendo-react-layout": "^15.0.0",
    "@progress/kendo-react-notification": "^15.0.0",
    "@progress/kendo-react-progressbars": "^15.0.0",
    "@progress/kendo-svg-icons": "^5.1.0",
    "@progress/kendo-theme-default": "^14.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "0.28.0",
    "@tanstack/ai-anthropic": "0.15.1",
    "@tanstack/ai-ollama": "0.8.1",
    "@tanstack/ai-openai": "0.14.1",
    "@tanstack/ai-openrouter": "0.13.1",
    "@tanstack/ai-react": "0.15.4",
    "@tanstack/query-db-collection": "latest",
    "@tanstack/react-db": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.5.3",
    "border-beam": "^1.2.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.545.0",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "knip": "^6.16.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "png-to-ico": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
