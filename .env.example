# ---------------------------------------------------------------------------
# Converge environment
# Copy to .env.local for development. On Railway, set these as service variables
# and reference the Postgres plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/converge"

# better-auth
# Generate a secret: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=""
# Public base URL of the app (used for OAuth callbacks, passkey rpID/origin).
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app
# Callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# AI Concierge (silo 7)
# ---------------------------------------------------------------------------
# Local Ollama server used as the no-key dev fallback when a user hasn't
# configured their own provider. Start one with `ollama serve`.
OLLAMA_BASE_URL="http://localhost:11434"
# Default model for the Ollama fallback (must be pulled: `ollama pull llama3.1`).
CONCIERGE_DEV_MODEL="llama3.1"
# Secret used to encrypt stored per-user provider API keys (AES-256-GCM).
# Defaults to BETTER_AUTH_SECRET when unset.
CONCIERGE_KEY_SECRET=""
